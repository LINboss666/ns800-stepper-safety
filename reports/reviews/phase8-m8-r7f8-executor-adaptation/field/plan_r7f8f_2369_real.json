            "[MOT] cur_hz=0 tgt_hz=0",
            "[MOT] armed=1 drv_en_request=1 health=OK",
            "[MOT] drv_request=HIGH pad=1",
            "[MOT] expected_ENN=LOW ENN_fb=0 resolved verdict=OK",
            "[MOT] arm_gate_mask="
          ],
          "poll": {
            "until_seconds": 1.0,
            "interval_seconds": 0.1,
            "max_attempts": 5,
            "retry_codes": [
              "EXPECTATION_NOT_MET"
            ]
          },
          "status_lines_allow": [
            "^\\[MOT\\] arm_gate_mask=0x2 REFUSED$"
          ],
          "expect_values": [
            {
              "row": "^\\[MOT\\] arm_gate_mask=(?P<mask>0x[0-9A-F]+) (?P<tail>REFUSED|ALL-PASS)$",
              "must_one_of": {
                "mask": [
                  "0x0",
                  "0x2"
                ],
                "tail": [
                  "ALL-PASS",
                  "REFUSED"
                ]
              }
            }
          ],
          "step_total_seconds": 1.0,
          "window_phase": "motion_active"
        },
        {
          "as": "disarm",
          "cmd": "motor_disarm",
          "key": "motor_disarm",
          "seconds": 2,
          "expect_contains": [
            "DISARM (动作已做"
          ],
          "quota": {
            "name": "motor_disarm",
            "n": 1
          },
          "step_total_seconds": 0.5,
          "window_phase": "post_zero"
        },
        {
          "as": "mot_disabled",
          "cmd": "motor_status",
          "key": "motor_status_idle",
          "seconds": 1,
          "expect_contains": [
            "[MOT] armed=0 drv_en_request=0",
            "expected_ENN=HIGH ENN_fb=1",
            "verdict=OK",
            "[MOT] arm_gate_mask=0x0"
          ],
          "status_lines_allow": [],
          "expect_values": [
            {
              "row": "^\\[MOT\\] arm_gate_mask=(?P<mask>0x[0-9A-F]+) (?P<tail>REFUSED|ALL-PASS)$",
              "must": {
                "mask": "0x0",
                "tail": "ALL-PASS"
              }
            }
          ],
          "step_total_seconds": 1.0,
          "window_phase": "post_zero"
        },
        {
          "as": "show_pre",
          "cmd": "diag_profile show",
          "key": "diag_profile_show",
          "seconds": 1,
          "expect_contains": [
            "[DIAG] profile"
          ],
          "step_total_seconds": 1.0,
          "window_phase": "post_zero"
        },
        {
          "as": "commit",
          "cmd": "diag_profile commit",
          "key": "diag_profile_commit",
          "seconds": 1,
          "expect_contains": [
            "[DIAG] commit OK"
          ],
          "quota": {
            "name": "diag_profile_commit",
            "n": 1
          },
          "step_total_seconds": 1.0,
          "window_phase": "post_zero"
        },
        {
          "as": "show_post",
          "cmd": "diag_profile show",
          "key": "diag_profile_show",
          "seconds": 1,
          "expect_contains": [

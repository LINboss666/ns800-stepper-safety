              "row": "^\\[DIAG\\] job id=(?P<id>[0-9]+) st=(?P<st>[A-Z_]+) why=(?P<why>[A-Z_]+) owner=(?P<owner>[0-9]+) cred=(?P<cred>[0-9]/[0-9])$",
              "states": [
                "RUNNING",
                "CANCEL_PENDING"
              ]
            },
            "job_binding": "done_job"
          },
          "poll_sequence": [
            "ls_run8a",
            "ls_done8"
          ],
          "step_total_seconds": 2.0,
          "window_phase": "motion_active"
        },
        {
          "as": "stop",
          "cmd": "motor_stop",
          "key": "motor_stop",
          "seconds": 2,
          "expect_contains": [

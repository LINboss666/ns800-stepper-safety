 "stages": [
  {
   "id": "S1",
   "kind": "serial_session",
   "scenario": "stub_only",
   "title": "取消试验 + DONE 试验 + 固定清理(全合成, 0 设备)",
   "port": "STUB_PORT_NOT_A_COM",
   "arm_energize_deadline_seconds": 30,
   "motion_cap_seconds": 62,
   "prerequisite_gates": [
    "stub_feed_only"
   ],
   "total_deadline_seconds": 120,
   "steps": [
    {
     "as": "baseline",
     "cmd": "motor_status",
     "key": "status_static",
     "seconds": 3,
     "expect_contains": [
      "state=0"
     ]
    },
    {
     "as": "dir",
     "cmd": "motor_dir 0",
     "key": "motor_dir",
     "seconds": 2,
     "expect_contains": [
      "dir=0"
     ]
    },
    {
     "as": "arm",
     "cmd": "motor_arm",
     "seconds": 3,
     "expect_contains": [
      "ARMED (drv_en request=HIGH readback verified"
     ]
    },
    {
     "as": "target",
     "cmd": "motor_target 100",
     "key": "motor_target",
     "seconds": 2,
     "expect_contains": [
      "target=100"
     ]
    },
    {
     "as": "start",
     "cmd": "motor_start",
     "seconds": 2,
     "expect_absent": [
      "REFUSED"
     ],
     "quota": {
      "name": "motor_run",
      "n": 1
     }
    },
    {
     "as": "cruise",
     "cmd": "motor_status",
     "key": "status_cruise",
     "seconds": 4,
     "expect_profile": "RUNNING",
     "poll": {
      "until_seconds": 4.0,
      "interval_seconds": 0.5,
      "retry_codes": [
       "PROFILE_NOT_RUNNING"
      ]
     },
     "poll_sequence": [
      "status_accel",
      "status_cruise"
     ]
    },
    {
     "as": "learn_cancel_job",
     "cmd": "diag_profile learn 8 450 550 0",
     "key": "learn_cancel_trial",
     "seconds": 3,
     "expect_contains": [
      "STARTED"
     ],
     "quota": {
      "name": "diag_profile_learn",
      "n": 1
     },
     "job_bind": {
      "name": "cancel_job",
      "params": {
       "n": 8,
       "lo": 450,
       "hi": 550,
       "dir": 0
      }
     }
    },
    {
     "as": "cancel",
     "cmd": "diag_profile learn_cancel @cancel_job",
     "key": "cancel_cmd",
     "seconds": 3,
     "job_cmd": "cancel_job",
     "expect_contains": [
      "REQUESTED"
     ],
     "quota": {
      "name": "diag_profile_learn_cancel",
      "n": 1
     }
    },
    {
     "as": "cancel_state",
     "cmd": "diag_profile learn_status",
     "key": "ls_cancelled",
     "seconds": 3,
     "expect_values": [
      {
       "row": "^\\[DIAG\\] job id=(?P<id>[0-9]+) st=(?P<st>[A-Z_]+) why=(?P<why>[A-Z_]+) owner=(?P<owner>[0-9]+) cred=(?P<cred>[0-9]/[0-9])$",
       "must": {
        "st": "CANCELLED",
        "owner": "0"
       },
       "job_binding": "cancel_job"
      }
     ]
    },
    {
     "as": "learn_done_job",
     "cmd": "diag_profile learn 8 450 550 0",
     "key": "learn_done_trial",
     "seconds": 3,
     "expect_contains": [
      "STARTED"
     ],
     "quota": {
      "name": "diag_profile_learn",
      "n": 1
     },
     "job_bind": {
      "name": "done_job",
      "params": {
       "n": 8,
       "lo": 450,
       "hi": 550,
       "dir": 0
      }
     }
    },
    {
     "as": "wait_done",
     "cmd": "diag_profile learn_status",
     "key": "ls_done",
     "seconds": 4,
     "poll": {
      "until_seconds": 4.0,
      "interval_seconds": 0.5,
      "retry_codes": [
       "FIELD_VALUE_MISMATCH",
       "PROFILE_NOT_RUNNING"
      ],
      "in_progress": {
       "row": "^\\[DIAG\\] job id=(?P<id>[0-9]+) st=(?P<st>[A-Z_]+) why=(?P<why>[A-Z_]+) owner=(?P<owner>[0-9]+) cred=(?P<cred>[0-9]/[0-9])$",
       "states": [
        "RUNNING",
        "CANCEL_PENDING"
       ]
      },
      "job_binding": "done_job",
      "max_attempts": 8
     },
     "poll_sequence": [
      "ls_running",
      "ls_running2",
      "ls_done"
     ],
     "expect_values": [
      {
       "row": "^\\[DIAG\\] job id=(?P<id>[0-9]+) st=(?P<st>[A-Z_]+) why=(?P<why>[A-Z_]+) owner=(?P<owner>[0-9]+) cred=(?P<cred>[0-9]/[0-9])$",
       "must": {
        "st": "DONE",
        "owner": "0",
        "cred": "1/1"
       },
       "job_binding": "done_job"
      },
      {
       "row": "^\\[DIAG\\] job n=(?P<adc>[0-9]+)/(?P<sg>[0-9]+) want=(?P<want>[0-9]+) win=(?P<lo>[0-9]+)\\.\\.(?P<hi>[0-9]+) dir=(?P<dir>[0-9]+)$",
       "must": {
        "want": 8
       },
       "must_min": {
        "adc": 8,
        "sg": 8
       }
      }
     ]
    },
    {
     "as": "stop",
     "cmd": "motor_stop",
     "seconds": 3,
     "expect_contains": [
      "stop requested"
     ]
    },
    {
     "as": "disarm",
     "cmd": "motor_disarm",
     "seconds": 3,
     "expect_contains": [
      "DISARM"
     ]
    },
    {
     "as": "final",
     "cmd": "motor_status",
     "key": "motor_status",
     "seconds": 3,
     "expect_contains": [
      "armed=0"
     ]
    }
   ]
  }
 ]
}
